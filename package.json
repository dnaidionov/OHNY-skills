{
  "name": "ohny-skill",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Unofficial OHNY Weekend assistant: data snapshot builder, stateless Cloudflare Worker, and the cross-platform skill.",
  "scripts": {
    "build:data": "node scripts/build-snapshot.mjs",
    "build:data:nogeo": "node scripts/build-snapshot.mjs --no-geocode",
    "test": "node --test \"test/*.test.js\"",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "package": "mkdir -p dist && cd skills && rm -f ../dist/ohny-skill.zip && zip -qr ../dist/ohny-skill.zip ohny",
    "build:icons": "node scripts/build-icons.mjs",
    "build:standalone": "node scripts/build-standalone.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "build:fallback": "node scripts/build-fallback.mjs",
    "prepackage": "npm test",
    "prepackage:chatgpt": "npm test",
    "package:chatgpt": "node scripts/build-chatgpt-plugin.mjs",
    "check:chatgpt-submission": "node scripts/build-chatgpt-plugin.mjs --require-metadata",
    "build:opal": "node scripts/build-opal.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
